{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": ".",
  "trailingSlash": true,
  "headers": [
    { "source": "/(.*)/invite.json", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/(core|themes)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }, { "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/(assets|themes)/(.*)\\.(mp3|otf|woff2|jpg|jpeg|png|webp|svg)", "headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }] },
    { "source": "/(.*)\\.(jpg|jpeg|png|webp|mp3|otf|woff2)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
