{
  "name": "sayhello",
  "private": true,
  "description": "SayHello: thiệp cưới online tự phục vụ. Monorepo: apps/web (Next.js), packages/engine (bộ máy thiệp), legacy (site tĩnh bản 1).",
  "workspaces": [
    "apps/*",
    "packages/*",
    "legacy"
  ],
  "scripts": {
    "dev": "npm run dev -w @sayhello/web",
    "dev:legacy": "npm run dev -w @sayhello/legacy",
    "build": "npm run build -w @sayhello/web",
    "test": "npm test -w @sayhello/engine && npm test -w @sayhello/legacy",
    "test:legacy": "npm test -w @sayhello/legacy",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "supabase": "^2.0.0"
  }
}
