{
  "name": "sayhello",
  "private": true,
  "description": "SayHello: thiệp cưới online. Monorepo: apps/web (Next.js), packages/engine (bộ máy thiệp), packages/themes (mẫu thiệp).",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/themes/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sayhello/web",
    "build": "npm run build -w @sayhello/web",
    "start": "npm run start -w @sayhello/web",
    "lint": "npm run lint -w @sayhello/web",
    "typecheck": "npm run typecheck -w @sayhello/web",
    "test": "npm test -w @sayhello/engine && node --test packages/themes/*/test/contract.test.js",
    "test:smoke": "node tests/smoke.mjs http://localhost:3000",
    "test:e2e": "node tests/e2e/run.mjs --tier=all",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "supabase": "^2.0.0"
  }
}
